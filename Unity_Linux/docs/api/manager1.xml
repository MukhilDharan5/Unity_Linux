
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.freedesktop.DBus.Introspectable">
    <method name="Introspect">
      <arg type="s" direction="out"/>
    </method>
  </interface>
  <interface name="org.freedesktop.DBus.Peer">
    <method name="Ping">
    </method>
    <method name="GetMachineId">
      <arg type="s" direction="out"/>
    </method>
  </interface>
  <interface name="org.freedesktop.DBus.Properties">
    <method name="Get">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="property_name" type="s" direction="in"/>
      <arg type="v" direction="out"/>
    </method>
    <method name="Set">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="property_name" type="s" direction="in"/>
      <arg name="value" type="v" direction="in"/>
    </method>
    <method name="GetAll">
      <arg name="interface_name" type="s" direction="in"/>
      <arg type="a{sv}" direction="out"/>
    </method>
    <signal name="PropertiesChanged">
      <arg name="interface_name" type="s"/>
      <arg name="changed_properties" type="a{sv}"/>
      <arg name="invalidated_properties" type="as"/>
    </signal>
  </interface>
  <interface name="org.unityconnect.Manager1">
    <method name="ListDevices">
      <arg type="ao" direction="out"/>
    </method>
    <method name="StartDiscovery">
      <arg name="seconds" type="u" direction="in"/>
    </method>
    <method name="PairingInfo">
      <arg type="s" direction="out"/>
    </method>
    <method name="FirefoxStatus">
      <arg type="s" direction="out"/>
    </method>
    <method name="SetFirefoxEnabled">
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <method name="RestoreFirefoxContext">
      <arg name="profile_id" type="s" direction="in"/>
      <arg name="context_id" type="s" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="ApprovePairing">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="approve" type="b" direction="in"/>
    </method>
    <method name="Unpair">
      <arg name="device_id" type="s" direction="in"/>
    </method>
    <method name="RequestAccess">
      <arg name="name" type="s" direction="in"/>
      <arg name="scopes" type="as" direction="in"/>
      <arg type="s" direction="out"/>
    </method>
    <method name="GetAccessStatus">
      <arg type="s" direction="out"/>
    </method>
    <method name="ListAccessRequests">
      <arg type="s" direction="out"/>
    </method>
    <method name="ApproveAccess">
      <arg name="client" type="s" direction="in"/>
      <arg name="approve" type="b" direction="in"/>
    </method>
    <method name="Diagnostics">
      <arg type="s" direction="out"/>
    </method>
    <method name="ListOperations">
      <arg type="s" direction="out"/>
    </method>
    <signal name="AccessRequested">
      <arg name="client" type="s"/>
    </signal>
    <signal name="Changed">
      <arg name="object_path" type="s"/>
    </signal>
    <property name="ApiVersion" type="u" access="read"/>
  </interface>
</node>
